{
  "name": "travel-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:docker": "docker compose up",
    "dev:docker:build": "docker compose build --no-cache",
    "dev:docker:down": "docker compose down",
    "dev:docker:logs": "docker compose logs -f",
    "dev:docker:mcp": "docker compose --profile mcp up",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @travel-calendar/shared build",
    "test": "pnpm -r test",
    "test:backend": "pnpm --filter @travel-calendar/backend test",
    "test:frontend": "pnpm --filter @travel-calendar/frontend test",
    "test:mcp": "pnpm --filter @travel-calendar/mcp-server test",
    "test:e2e": "bash tests/e2e/run-all.sh",
    "lint": "pnpm -r lint && pnpm lint:boundaries && pnpm lint:commits",
    "lint:boundaries": "node scripts/check-boundaries.js",
    "lint:commits": "node scripts/check-commits.js",
    "validate:map": "node scripts/validate-map.js",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
