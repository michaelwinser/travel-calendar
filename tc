#!/bin/sh
# Travel Calendar - Helper Script
#
# Works on macOS and TrueNAS (FreeBSD)
#
# Usage:
#   ./tc <command> [options]
#
# Run ./tc help for full command list.

set -e

# ===========================================
# Configuration
# ===========================================

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# Load .env file if present (docker compose does this automatically, but
# shell commands like 'deploy' need these variables too)
if [ -f .env ]; then
    set -a
    . ./.env
    set +a
fi

# Colors (disabled if NO_COLOR set or not a terminal)
if [ -z "$NO_COLOR" ] && [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    NC=''
fi

# ===========================================
# Helpers
# ===========================================

info() {
    printf "${BLUE}▶${NC} %s\n" "$1"
}

success() {
    printf "${GREEN}✓${NC} %s\n" "$1"
}

warn() {
    printf "${YELLOW}⚠${NC} %s\n" "$1"
}

error() {
    printf "${RED}✗${NC} %s\n" "$1" >&2
    exit 1
}

confirm() {
    printf "${YELLOW}?${NC} %s [y/N] " "$1"
    read -r response
    case "$response" in
        [yY][eE][sS]|[yY]) return 0 ;;
        *) return 1 ;;
    esac
}

require_docker() {
    if ! command -v docker >/dev/null 2>&1; then
        error "Docker is not installed. Please install Docker first."
    fi
    if ! docker info >/dev/null 2>&1; then
        error "Docker is not running. Please start Docker first."
    fi
}

# ===========================================
# Commands: Service Management
# ===========================================

cmd_start() {
    require_docker
    info "Starting services..."

    detach="-d"

    while [ $# -gt 0 ]; do
        case "$1" in
            --fg|-f)   detach="" ;;
            *)         break ;;
        esac
        shift
    done

    # shellcheck disable=SC2086
    docker compose up --remove-orphans $detach "$@"

    if [ -n "$detach" ]; then
        success "Services started"
        echo ""
        echo "  Backend + MCP:       http://localhost:${PORT_1:-4000}"
        echo ""
        echo "  View logs: ./tc logs"
        echo "  Stop:      ./tc stop"
    fi
}

cmd_stop() {
    require_docker
    info "Stopping services..."
    docker compose down --remove-orphans "$@"
    success "Services stopped"
}

cmd_restart() {
    require_docker
    info "Restarting services..."
    cmd_stop
    cmd_start "$@"
}

cmd_build() {
    require_docker
    info "Building containers..."

    no_cache=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --clean|--no-cache) no_cache="--no-cache" ;;
            *) break ;;
        esac
        shift
    done

    # Build all services including those in profiles
    # shellcheck disable=SC2086
    docker compose --profile dev build $no_cache "$@"
    success "Build complete"
}

cmd_logs() {
    require_docker
    service="${1:-}"
    if [ -n "$service" ]; then
        docker compose logs -f "$service"
    else
        docker compose logs -f
    fi
}

cmd_status() {
    require_docker
    docker compose ps --all
}

cmd_shell() {
    require_docker
    service="${1:-dev}"
    info "Opening shell in $service..."
    if [ "$service" = "dev" ]; then
        docker compose run --rm dev sh
    else
        docker compose exec "$service" sh
    fi
}

# ===========================================
# Commands: Testing
# ===========================================

cmd_test() {
    require_docker

    target="${1:-all}"
    shift 2>/dev/null || true

    case "$target" in
        all)
            info "Running all tests..."
            cmd_test_backend
            cmd_test_frontend
            success "All tests passed"
            ;;
        e2e)
            info "Running E2E tests..."
            export TRAVEL_API_URL="http://localhost:3000"
            ./tests/e2e/run-all.sh
            ;;
        backend)
            cmd_test_backend
            ;;
        frontend)
            cmd_test_frontend
            ;;
        browser)
            cmd_test_browser "$@"
            ;;
        *)
            error "Unknown test target: $target. Use: all, e2e, backend, frontend, browser"
            ;;
    esac
}

cmd_test_backend() {
    require_docker
    info "Running backend tests (Go)..."

    docker compose run --rm --no-deps -T \
        dev sh -c "cd /app/packages/backend && go test ./..."
    success "Backend tests passed"
}

cmd_test_frontend() {
    require_docker
    info "Running frontend tests..."
    docker compose run --rm --no-deps -T dev sh -c "cd /app/packages/frontend && pnpm test run"
    success "Frontend tests passed"
}

cmd_test_browser() {
    require_docker

    video_env=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --video) video_env="-e PLAYWRIGHT_VIDEO=on" ;;
            *) break ;;
        esac
        shift
    done

    info "Running browser tests (Playwright)..."

    # Ensure backend is running
    if ! docker compose ps backend 2>/dev/null | grep -q "running"; then
        info "Starting backend for browser tests..."
        docker compose up -d backend
        # Wait for health check
        info "Waiting for backend to be healthy..."
        for i in $(seq 1 30); do
            if docker compose exec -T backend curl -sf http://localhost:3000/health >/dev/null 2>&1; then
                break
            fi
            sleep 1
        done
    fi

    # Run Playwright tests via the dev container
    # shellcheck disable=SC2086
    docker compose run --rm -T \
        -e PLAYWRIGHT_SKIP_WEBSERVER=1 \
        -e PLAYWRIGHT_BASE_URL=http://backend:3000 \
        $video_env \
        dev sh -c "cd /app/packages/frontend && pnpm exec playwright test --reporter=list"

    success "Browser tests passed"
}

cmd_test_precommit() {
    require_docker
    info "Running pre-commit checks..."

    failed=0

    # Backend Go tests (includes MCP server)
    info "Running backend tests (Go)..."
    if ! docker compose run --rm --no-deps -T \
        dev sh -c "cd /app/packages/backend && go test ./..."; then
        warn "Backend tests failed"
        failed=1
    fi

    # Frontend type checking (only if svelte-check is installed)
    info "Running frontend type check..."
    if ! docker compose run --rm --no-deps -T dev sh -c "cd /app/packages/frontend && pnpm exec svelte-check --threshold warning 2>/dev/null"; then
        # Check if svelte-check is installed
        if docker compose run --rm --no-deps -T dev sh -c "cd /app/packages/frontend && pnpm exec svelte-check --help >/dev/null 2>&1"; then
            warn "Frontend type check failed"
            failed=1
        else
            info "Skipping frontend type check (svelte-check not installed)"
        fi
    fi

    if [ $failed -eq 0 ]; then
        success "All pre-commit checks passed"
        return 0
    else
        error "Pre-commit checks failed"
    fi
}

# ===========================================
# Commands: Database
# ===========================================

cmd_db_reset() {
    require_docker
    if confirm "This will stop services, delete the database volume, and restart. Are you sure?"; then
        info "Stopping services..."
        docker compose down --remove-orphans 2>/dev/null || true

        info "Removing database volume..."
        docker volume rm travel-backend-data 2>/dev/null || true

        info "Starting services..."
        docker compose up -d --remove-orphans

        success "Database reset complete"
        echo ""
        echo "  Backend: http://localhost:${PORT_1:-4000}"
    else
        info "Cancelled"
    fi
}

# ===========================================
# Commands: Admin
# ===========================================

cmd_admin() {
    action="${1:-}"
    shift 2>/dev/null || true

    case "$action" in
        delete-user)
            cmd_admin_delete_user "$@"
            ;;
        cleanup-orphans)
            cmd_admin_cleanup_orphans
            ;;
        *)
            echo "Usage: ./tc admin <command>"
            echo ""
            echo "  delete-user <email>   Delete all data for a specific user"
            echo "  cleanup-orphans       Remove data with empty user_id (pre-migration leftovers)"
            ;;
    esac
}

cmd_admin_delete_user() {
    require_docker
    email="${1:-}"
    if [ -z "$email" ]; then
        error "Usage: ./tc admin delete-user <email>"
    fi

    if confirm "Delete ALL data for user '${email}'? This cannot be undone."; then
        info "Deleting data for ${email}..."
        docker compose exec -T backend sh -c "
            sqlite3 /app/data/travel.db \"
                DELETE FROM day_entries WHERE user_id = '${email}';
                DELETE FROM processed_calendar_events WHERE user_id = '${email}';
                DELETE FROM user_calendars WHERE user_id = '${email}';
                DELETE FROM google_credentials WHERE user_id = '${email}';
                DELETE FROM sessions WHERE user_id = '${email}';
                DELETE FROM items WHERE trip_id IN (SELECT id FROM trips WHERE user_id = '${email}');
                DELETE FROM trip_locations WHERE trip_id IN (SELECT id FROM trips WHERE user_id = '${email}');
                DELETE FROM trips WHERE user_id = '${email}';
            \"
        " 2>/dev/null && success "Data deleted for ${email}" || error "Failed — is the backend running with SQLite?"
    else
        info "Cancelled"
    fi
}

cmd_admin_cleanup_orphans() {
    require_docker
    if confirm "Delete all data with empty user_id (pre-migration orphans)?"; then
        info "Cleaning up orphaned data..."
        docker compose exec -T backend sh -c "
            sqlite3 /app/data/travel.db \"
                DELETE FROM day_entries WHERE user_id = '';
                DELETE FROM processed_calendar_events WHERE user_id = '';
                DELETE FROM user_calendars WHERE user_id = '';
                DELETE FROM sessions WHERE user_id = '';
                DELETE FROM items WHERE trip_id IN (SELECT id FROM trips WHERE user_id = '');
                DELETE FROM trip_locations WHERE trip_id IN (SELECT id FROM trips WHERE user_id = '');
                DELETE FROM trips WHERE user_id = '';
                SELECT 'Done. Remaining trips: ' || COUNT(*) FROM trips;
            \"
        " 2>/dev/null && success "Orphaned data cleaned up" || error "Failed — is the backend running with SQLite?"
    else
        info "Cancelled"
    fi
}

# ===========================================
# Commands: Health & Diagnostics
# ===========================================

cmd_health() {
    require_docker

    service="${1:-all}"

    check_endpoint() {
        local name=$1
        local url=$2
        local result

        result=$(docker compose exec backend curl -sf "$url" 2>/dev/null)
        if [ $? -eq 0 ]; then
            printf "${GREEN}✓${NC} %s: %s\n" "$name" "$result"
            return 0
        else
            printf "${RED}✗${NC} %s: not responding\n" "$name"
            return 1
        fi
    }

    case "$service" in
        all|backend)
            info "Checking service health..."
            check_endpoint "Backend + MCP" "http://localhost:3000/health"
            ;;
        *)
            echo "Usage: ./tc health [service]"
            echo ""
            echo "  all      - Check all services (default)"
            echo "  backend  - Check backend health (includes MCP)"
            ;;
    esac
}

cmd_curl() {
    require_docker

    if [ $# -eq 0 ]; then
        echo "Usage: ./tc curl <url> [curl-options...]"
        echo ""
        echo "Run curl inside the backend container (uses internal port 3000)."
        echo ""
        echo "Examples:"
        echo "  ./tc curl http://localhost:3000/health"
        echo "  ./tc curl -X POST http://localhost:3000/api/trips -d '{\"name\":\"test\"}'"
        return 0
    fi

    # Ensure backend is running (has curl installed)
    if ! docker compose ps backend 2>/dev/null | grep -q "running"; then
        info "Starting backend container..." >&2
        docker compose up -d backend >/dev/null 2>&1
        sleep 3
    fi

    docker compose exec -T backend curl -s "$@"
}

# ===========================================
# Commands: Code Generation
# ===========================================

cmd_generate() {
    require_docker

    target="${1:-all}"

    case "$target" in
        all)
            info "Generating all code from OpenAPI spec..."
            cmd_generate_backend
            cmd_generate_shared
            success "All code generation complete"
            ;;
        backend)
            cmd_generate_backend
            ;;
        shared)
            cmd_generate_shared
            ;;
        *)
            error "Unknown generate target: $target. Use: all, backend, shared"
            ;;
    esac
}

cmd_generate_backend() {
    info "Generating backend Go types from OpenAPI..."
    docker compose run --rm --no-deps -T dev sh -c \
        "cd packages/backend && oapi-codegen -generate types,chi-server -package api ../api/openapi.yaml > internal/api/openapi.gen.go 2>/dev/null"
    success "Backend types generated"
}

cmd_generate_shared() {
    info "Generating shared TypeScript types from OpenAPI..."
    docker compose run --rm --no-deps -T dev sh -c \
        "cd /app && pnpm install --frozen-lockfile 2>/dev/null; pnpm --filter @travel-calendar/shared generate"
    success "Shared types generated"
}

# ===========================================
# Commands: Provision & Deploy
# ===========================================

DEPLOY_SERVICE="travel-calendar"
DEPLOY_REPO="travel-calendar"

require_gcloud() {
    if ! command -v gcloud >/dev/null 2>&1; then
        error "gcloud CLI is not installed. See https://cloud.google.com/sdk/docs/install"
    fi
}

require_project_id() {
    if [ -z "$GOOGLE_CLOUD_PROJECT" ]; then
        error "GOOGLE_CLOUD_PROJECT is not set in .env"
    fi
}

deploy_region() {
    echo "${CLOUD_RUN_REGION:-us-central1}"
}

cmd_provision() {
    require_gcloud
    require_project_id

    REGION="$(deploy_region)"

    info "Provisioning GCP resources for project: ${GOOGLE_CLOUD_PROJECT} (${REGION})"

    # Enable required APIs
    info "Enabling GCP APIs..."
    gcloud services enable \
        cloudbuild.googleapis.com \
        artifactregistry.googleapis.com \
        run.googleapis.com \
        firestore.googleapis.com \
        --project "$GOOGLE_CLOUD_PROJECT"
    success "APIs enabled"

    # Create Artifact Registry repository (if it doesn't exist)
    info "Ensuring Artifact Registry repository exists..."
    if gcloud artifacts repositories describe "$DEPLOY_REPO" \
        --location "$REGION" \
        --project "$GOOGLE_CLOUD_PROJECT" >/dev/null 2>&1; then
        success "Artifact Registry repository already exists"
    else
        gcloud artifacts repositories create "$DEPLOY_REPO" \
            --repository-format docker \
            --location "$REGION" \
            --project "$GOOGLE_CLOUD_PROJECT" \
            --description "Travel Calendar container images"
        success "Artifact Registry repository created"
    fi

    # Configure Docker authentication for Artifact Registry
    info "Configuring Docker authentication..."
    gcloud auth configure-docker "${REGION}-docker.pkg.dev" --quiet
    success "Docker authentication configured"

    # Create Firestore database (if it doesn't exist)
    info "Ensuring Firestore database exists..."
    if gcloud firestore databases describe \
        --project "$GOOGLE_CLOUD_PROJECT" >/dev/null 2>&1; then
        success "Firestore database already exists"
    else
        gcloud firestore databases create \
            --location "$REGION" \
            --project "$GOOGLE_CLOUD_PROJECT"
        success "Firestore database created"
    fi

    echo ""
    success "Provisioning complete. You can now run: ./tc deploy"
}

cmd_deploy() {
    require_gcloud
    require_project_id

    REGION="$(deploy_region)"

    action="${1:-}"

    case "$action" in
        status)
            cmd_deploy_status
            ;;
        "")
            cmd_deploy_source
            ;;
        *)
            echo "Usage: ./tc deploy [status]"
            echo ""
            echo "  (no args)  - Build and deploy to Cloud Run via Cloud Build"
            echo "  status     - Show current Cloud Run service status"
            echo ""
            echo "Environment variables (set in .env):"
            echo "  GOOGLE_CLOUD_PROJECT  - GCP project ID (required)"
            echo "  CLOUD_RUN_REGION      - Deploy region (default: us-central1)"
            ;;
    esac
}

cmd_deploy_source() {
    REGION="$(deploy_region)"
    info "Deploying to Cloud Run via Cloud Build (${REGION})..."

    # Build env-vars flag from known config
    ENV_VARS="STORE_TYPE=firestore,GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT}"

    # Append Google OAuth vars if set
    if [ -n "${GOOGLE_CLIENT_ID:-}" ]; then
        ENV_VARS="${ENV_VARS},GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}"
    fi
    if [ -n "${GOOGLE_CLIENT_SECRET:-}" ]; then
        ENV_VARS="${ENV_VARS},GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}"
    fi
    if [ -n "${GOOGLE_REDIRECT_URL:-}" ]; then
        ENV_VARS="${ENV_VARS},GOOGLE_REDIRECT_URL=${GOOGLE_REDIRECT_URL}"
    fi

    gcloud run deploy "$DEPLOY_SERVICE" \
        --source . \
        --region "$REGION" \
        --project "$GOOGLE_CLOUD_PROJECT" \
        --allow-unauthenticated \
        --port 3000 \
        --set-env-vars "$ENV_VARS" \
        --quiet

    success "Deployed to Cloud Run"
    gcloud run services describe "$DEPLOY_SERVICE" \
        --region "$REGION" \
        --project "$GOOGLE_CLOUD_PROJECT" \
        --format='value(status.url)'
}

cmd_deploy_status() {
    REGION="$(deploy_region)"
    info "Cloud Run service status..."
    gcloud run services describe "$DEPLOY_SERVICE" \
        --region "$REGION" \
        --project "$GOOGLE_CLOUD_PROJECT" \
        --platform managed
}

# ===========================================
# Commands: Cleanup
# ===========================================

cmd_clean() {
    require_docker

    level="${1:-containers}"

    case "$level" in
        containers)
            if confirm "Remove all containers?"; then
                info "Removing containers..."
                docker compose --profile dev down
                success "Containers removed"
            fi
            ;;
        volumes)
            if confirm "Remove containers AND volumes (database, Go cache)?"; then
                info "Removing containers and volumes..."
                docker compose --profile dev down -v
                success "Containers and volumes removed"
            fi
            ;;
        all)
            if confirm "Remove containers, volumes, AND build cache?"; then
                info "Removing everything..."
                docker compose --profile dev down -v --rmi local
                docker builder prune -f
                success "Full cleanup complete"
            fi
            ;;
        *)
            echo "Usage: ./tc clean [containers|volumes|all]"
            echo ""
            echo "  containers - Remove containers only (default)"
            echo "  volumes    - Remove containers and volumes (database, Go cache)"
            echo "  all        - Remove everything including build cache"
            ;;
    esac
}

# ===========================================
# Commands: Help
# ===========================================

cmd_help() {
    cat <<'EOF'
Travel Calendar - Helper Script

Usage: ./tc <command> [options]

Service Commands:
  start [--fg]           Start services (--fg for foreground mode)
  stop                   Stop all services
  restart                Restart all services
  build [--clean]        Build containers (--clean for fresh build)
  logs [service]         View logs (optionally for specific service)
  status                 Show container status
  shell [service]        Open shell in container (default: dev)

Testing & Quality:
  test [target]          Run tests (all, e2e, backend, frontend, browser)
  test browser --video   Run browser tests with video recording
  test-precommit         Pre-commit checks (Go tests, type checking)

Code Generation:
  generate [target]      Generate code from OpenAPI (all, backend, shared)

Database:
  db:reset               Reset database (stops services, removes volume, restarts)

Admin:
  admin delete-user <email>   Delete all data for a specific user
  admin cleanup-orphans       Remove pre-migration orphaned data

Health & Diagnostics:
  health [service]       Check service health
  curl <url> [opts]      Run curl inside backend container (port 3000)

Cloud (requires gcloud CLI + GOOGLE_CLOUD_PROJECT in .env):
  provision              Enable GCP APIs and create resources (one-time)
  deploy                 Build and deploy to Cloud Run via Cloud Build
  deploy status          Show Cloud Run service status

Cleanup:
  clean [level]          Cleanup (containers, volumes, all)

Other:
  help                   Show this help message

Examples:
  ./tc start                     # Start backend
  ./tc logs                      # Follow all service logs
  ./tc health                    # Check service health
  ./tc test backend              # Run backend Go tests
  ./tc test-precommit            # Run pre-commit checks
  ./tc generate                  # Regenerate all code from OpenAPI
  ./tc db:reset                  # Reset database and restart
  ./tc shell                     # Open shell in dev container
  ./tc provision                 # One-time GCP setup
  ./tc deploy                    # Deploy to Cloud Run
  ./tc clean volumes             # Remove containers, database, and caches
EOF
}

# ===========================================
# Main
# ===========================================

command="${1:-help}"
shift 2>/dev/null || true

case "$command" in
    start)      cmd_start "$@" ;;
    stop)       cmd_stop "$@" ;;
    restart)    cmd_restart "$@" ;;
    build)      cmd_build "$@" ;;
    logs)       cmd_logs "$@" ;;
    status)     cmd_status "$@" ;;
    shell|sh)   cmd_shell "$@" ;;

    test)       cmd_test "$@" ;;
    test-precommit)  cmd_test_precommit "$@" ;;
    generate)   cmd_generate "$@" ;;
    provision)  cmd_provision "$@" ;;
    deploy)     cmd_deploy "$@" ;;

    db:reset)   cmd_db_reset "$@" ;;
    admin)      cmd_admin "$@" ;;

    clean)      cmd_clean "$@" ;;

    health)     cmd_health "$@" ;;
    curl)       cmd_curl "$@" ;;

    help|--help|-h)
        cmd_help
        ;;
    *)
        error "Unknown command: $command. Run './tc help' for usage."
        ;;
esac
