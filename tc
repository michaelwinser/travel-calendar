#!/bin/sh
# travel-calendar — Project Command Script
#
# Usage: ./tc <command> [options]
#
# Run ./tc help for full command list.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

APPBASE_DIR="$SCRIPT_DIR/../appbase"

# Colors (disabled if NO_COLOR set or not a terminal)
if [ -z "$NO_COLOR" ] && [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    BLUE='\033[0;34m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    BLUE=''
    NC=''
fi

info() { printf "${BLUE}▶${NC} %s\n" "$1"; }
success() { printf "${GREEN}✓${NC} %s\n" "$1"; }
error() { printf "${RED}✗${NC} %s\n" "$1" >&2; exit 1; }

# Source appbase deploy functions (if available)
# DEPLOY_DIR must point to appbase's deploy dir so deploy.sh finds its siblings
if [ -f "$APPBASE_DIR/deploy/deploy.sh" ]; then
    DEPLOY_DIR="$APPBASE_DIR/deploy"
    . "$APPBASE_DIR/deploy/deploy.sh"
fi

# Load secrets from OS keychain (primary) or .env (CI fallback)
_load_secrets() {
    project="$(app_name)"
    exports=$(go run "$APPBASE_DIR/cmd/secret" env "$project" 2>/dev/null || true)
    if [ -n "$exports" ]; then eval "$exports"; return; fi
    if [ -f "$SCRIPT_DIR/.env" ]; then set -a; . "$SCRIPT_DIR/.env"; set +a; fi
}

# ===========================================
# Commands
# ===========================================

cmd_build() {
    info "Building travel-calendar..."
    go build -o travel .
    success "Built ./travel"
}

cmd_test() {
    target="${1:-all}"
    case "$target" in
        all)
            info "Running all tests..."
            go test -v -count=1 ./...
            success "All tests passed"
            ;;
        *)
            info "Running tests matching $target..."
            go test -v -count=1 -run "$target" ./...
            ;;
    esac
}

cmd_serve() {
    _load_secrets
    mkdir -p data
    go run . serve
}

cmd_codegen() {
    spec="${1:-openapi.yaml}"
    if [ ! -f "$spec" ]; then
        error "No $spec found"
    fi

    # Find oapi-codegen
    CODEGEN="oapi-codegen"
    if ! command -v oapi-codegen >/dev/null 2>&1; then
        if [ -x "$(go env GOPATH)/bin/oapi-codegen" ]; then
            CODEGEN="$(go env GOPATH)/bin/oapi-codegen"
        else
            info "Installing oapi-codegen..."
            go install github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@latest
            CODEGEN="$(go env GOPATH)/bin/oapi-codegen"
        fi
    fi

    mkdir -p api

    info "Generating server from $spec..."
    "$CODEGEN" --config oapi-codegen.yaml "$spec"

    info "Generating client from $spec..."
    "$CODEGEN" --config oapi-codegen-client.yaml "$spec"

    success "Codegen complete"
}

cmd_lint() {
    info "Running lints..."
    go vet ./...
    success "Lint passed"
}

cmd_lint_api() {
    info "Checking API-first pattern..."
    errors=0

    if [ ! -f openapi.yaml ]; then
        error "No openapi.yaml found"
    fi

    # Check generated code is up to date
    if [ -d api ]; then
        CODEGEN="oapi-codegen"
        if ! command -v oapi-codegen >/dev/null 2>&1; then
            if [ -x "$(go env GOPATH)/bin/oapi-codegen" ]; then
                CODEGEN="$(go env GOPATH)/bin/oapi-codegen"
            fi
        fi

        if command -v "$CODEGEN" >/dev/null 2>&1 || [ -x "$CODEGEN" ]; then
            tmpdir=$(mktemp -d)
            trap "rm -rf $tmpdir" EXIT

            # oapi-codegen --config writes to the output path in the config,
            # so we create temp configs that redirect output to our temp dir
            sed "s|api/server.gen.go|$tmpdir/server.gen.go|" oapi-codegen.yaml > "$tmpdir/server-cfg.yaml"
            "$CODEGEN" --config "$tmpdir/server-cfg.yaml" openapi.yaml 2>/dev/null
            if ! diff -q api/server.gen.go "$tmpdir/server.gen.go" >/dev/null 2>&1; then
                echo "  FAIL: api/server.gen.go is out of date. Run: ./tc codegen"
                errors=$((errors + 1))
            else
                echo "  OK: api/server.gen.go is up to date"
            fi

            sed "s|api/client.gen.go|$tmpdir/client.gen.go|" oapi-codegen-client.yaml > "$tmpdir/client-cfg.yaml"
            "$CODEGEN" --config "$tmpdir/client-cfg.yaml" openapi.yaml 2>/dev/null
            if ! diff -q api/client.gen.go "$tmpdir/client.gen.go" >/dev/null 2>&1; then
                echo "  FAIL: api/client.gen.go is out of date. Run: ./tc codegen"
                errors=$((errors + 1))
            else
                echo "  OK: api/client.gen.go is up to date"
            fi
        else
            echo "  SKIP: oapi-codegen not installed"
        fi
    fi

    # Check for hand-written /api/ routes
    handwritten=$(grep -rn '\.Get("/api/\|\.Post("/api/\|\.Put("/api/\|\.Delete("/api/\|\.Patch("/api/' \
        --include="*.go" \
        --exclude="*_test.go" \
        --exclude="*.gen.go" \
        . 2>/dev/null | grep -v "/api/auth/" || true)

    if [ -n "$handwritten" ]; then
        echo "  WARN: Hand-written /api/ routes found (should be in openapi.yaml):"
        echo "$handwritten" | while IFS= read -r line; do
            echo "    $line"
        done
    else
        echo "  OK: No hand-written /api/ routes"
    fi

    if [ "$errors" -gt 0 ]; then
        error "API lint: $errors error(s) found"
    else
        success "API lint passed"
    fi
}

cmd_ci() {
    info "Running CI pipeline..."
    cmd_lint
    cmd_lint_api
    cmd_build
    cmd_test all
    success "CI pipeline passed"
}

cmd_secret() {
    project="$(app_name)"
    if [ -z "$1" ]; then
        echo "Usage: ./tc secret <set|get|delete|list|import> [args...]"
        exit 1
    fi
    go run "$APPBASE_DIR/cmd/secret" "$1" "$project" ${2:+"$2"} ${3:+"$3"}
}

cmd_provision() {
    email="${1:-}"
    project="$(app_gcp_project)"
    app="$(app_name)"
    if [ -z "$email" ]; then
        echo "Usage: ./tc provision <support-email> [billing-account]"
        echo "  Reads name and gcpProject from app.json"
        exit 1
    fi
    provision_gcp "$project" "$app" "$email" "$2"
}

cmd_deploy() {
    _load_secrets
    deploy_cloudrun "$(app_name)" "$(app_gcp_project)" "$(app_region)"
}

cmd_help() {
    cat <<'EOF'
travel-calendar — Project Command Script

Usage: ./tc <command> [options]

Development:
  build              Build the travel binary
  test [pattern]     Run tests (all, or matching pattern)
  serve              Start the server (loads secrets, creates data dir)
  lint               Run go vet
  lint-api           Verify codegen is up to date, no hand-written routes
  codegen [spec]     Regenerate server + client from openapi.yaml
  ci                 Full CI pipeline (lint + lint-api + build + test)

Secrets & Config:
  secret <cmd>       Manage secrets in OS keychain (set, get, delete, list, import)

Deployment:
  provision <email>  Full GCP setup (project, billing, APIs, OAuth)
  deploy             Deploy to Cloud Run

Other:
  help               Show this help message

Examples:
  ./tc serve                     # Start server locally
  ./tc codegen                   # Regenerate API code after spec changes
  ./tc secret import creds.json  # Import Google OAuth credentials
  ./tc ci                        # Run full CI before committing
EOF
}

# ===========================================
# Main
# ===========================================

command="${1:-help}"
shift 2>/dev/null || true

case "$command" in
    build)          cmd_build "$@" ;;
    test)           cmd_test "$@" ;;
    serve)          cmd_serve "$@" ;;
    codegen)        cmd_codegen "$@" ;;
    lint)           cmd_lint "$@" ;;
    lint-api)       cmd_lint_api "$@" ;;
    ci)             cmd_ci "$@" ;;
    secret)         cmd_secret "$@" ;;
    provision)      cmd_provision "$@" ;;
    deploy)         cmd_deploy "$@" ;;
    help|--help|-h) cmd_help ;;
    *)              error "Unknown command: $command. Run './tc help' for usage." ;;
esac
