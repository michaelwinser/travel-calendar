#!/bin/sh
# Travel Calendar - Helper Script
#
# Works on macOS and TrueNAS (FreeBSD)
#
# Usage:
#   ./tc <command> [options]
#
# Commands:
#   start           Start all services
#   stop            Stop all services
#   restart         Restart all services
#   build           Build/rebuild containers
#   logs            View logs (follow mode)
#   status          Show service status
#   shell           Open shell in a container
#   test            Run tests
#   test-precommit  Fast pre-commit checks
#   lint            Run linting
#
#   db:reset    Reset database (delete and recreate)
#   db:backup   Backup database to file
#   db:restore  Restore database from backup
#   db:shell    Open SQLite shell
#
#   sandbox     Manage sandbox container for Claude Code
#   exec        Run command in sandbox container
#
#   clean       Remove containers, volumes, and build cache
#   help        Show this help message

set -e

# ===========================================
# Configuration
# ===========================================

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# Colors (disabled if NO_COLOR set or not a terminal)
if [ -z "$NO_COLOR" ] && [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    NC=''
fi

# Database location
DATA_DIR="$SCRIPT_DIR/data"
DB_FILE="$DATA_DIR/travel.db"
BACKUP_DIR="$DATA_DIR/backups"

# ===========================================
# Helpers
# ===========================================

info() {
    printf "${BLUE}▶${NC} %s\n" "$1"
}

success() {
    printf "${GREEN}✓${NC} %s\n" "$1"
}

warn() {
    printf "${YELLOW}⚠${NC} %s\n" "$1"
}

error() {
    printf "${RED}✗${NC} %s\n" "$1" >&2
    exit 1
}

confirm() {
    printf "${YELLOW}?${NC} %s [y/N] " "$1"
    read -r response
    case "$response" in
        [yY][eE][sS]|[yY]) return 0 ;;
        *) return 1 ;;
    esac
}

require_docker() {
    if ! command -v docker >/dev/null 2>&1; then
        error "Docker is not installed. Please install Docker first."
    fi
    if ! docker info >/dev/null 2>&1; then
        error "Docker is not running. Please start Docker first."
    fi
}

# ===========================================
# Commands: Service Management
# ===========================================

cmd_start() {
    require_docker
    info "Starting services..."

    profile=""
    detach="-d"

    while [ $# -gt 0 ]; do
        case "$1" in
            --mcp)     profile="--profile mcp" ;;
            --test)    profile="--profile test" ;;
            --fg|-f)   detach="" ;;
            *)         break ;;
        esac
        shift
    done

    # shellcheck disable=SC2086
    docker compose $profile up $detach "$@"

    if [ -n "$detach" ]; then
        success "Services started"
        echo ""
        echo "  Backend:  http://localhost:3000"
        echo "  Frontend: http://localhost:5173"
        [ -n "$profile" ] && echo "  MCP:      http://localhost:3001"
        echo ""
        echo "  View logs: ./tc logs"
        echo "  Stop:      ./tc stop"
    fi
}

cmd_stop() {
    require_docker
    info "Stopping services..."
    docker compose --profile mcp --profile test down "$@"
    success "Services stopped"
}

cmd_restart() {
    require_docker
    info "Restarting services..."
    cmd_stop
    cmd_start "$@"
}

cmd_build() {
    require_docker
    info "Building containers..."

    no_cache=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --clean|--no-cache) no_cache="--no-cache" ;;
            *) break ;;
        esac
        shift
    done

    # shellcheck disable=SC2086
    docker compose build $no_cache "$@"
    success "Build complete"
}

cmd_logs() {
    require_docker
    service="${1:-}"
    if [ -n "$service" ]; then
        docker compose logs -f "$service"
    else
        docker compose logs -f
    fi
}

cmd_status() {
    require_docker
    docker compose ps --all
}

cmd_shell() {
    require_docker
    service="${1:-backend}"
    info "Opening shell in $service..."
    docker compose exec "$service" sh
}

# ===========================================
# Commands: Testing & Linting
# ===========================================

cmd_test() {
    require_docker

    target="${1:-all}"

    case "$target" in
        all)
            info "Running all tests..."
            docker compose --profile test up --abort-on-container-exit test
            ;;
        e2e)
            info "Running E2E tests..."
            export TRAVEL_API_URL="http://localhost:3000"
            ./tests/e2e/run-all.sh
            ;;
        backend)
            info "Running backend tests (Go)..."
            docker compose exec backend sh -c "go test ./..."
            ;;
        mcp)
            info "Running MCP server tests (Go)..."
            docker compose exec mcp sh -c "go test ./..."
            ;;
        frontend)
            info "Running frontend tests..."
            docker compose exec frontend pnpm test
            ;;
        *)
            error "Unknown test target: $target. Use: all, e2e, backend, frontend, mcp"
            ;;
    esac
}

cmd_test_precommit() {
    require_docker
    info "Running pre-commit checks..."

    # Ensure backend is healthy (test container depends on it)
    if ! docker compose ps backend 2>/dev/null | grep -q "running"; then
        info "Starting backend container..."
        docker compose up -d backend
        info "Waiting for backend to be healthy..."
        sleep 5
    fi

    failed=0

    # Backend Go tests (use test container which has all packages mounted)
    info "Running backend tests (Go)..."
    if ! docker compose run --rm --no-deps test sh -c "cd /app/packages/backend && go test ./..."; then
        warn "Backend tests failed"
        failed=1
    fi

    # MCP server Go tests
    info "Running MCP server tests (Go)..."
    if ! docker compose run --rm --no-deps test sh -c "cd /app/packages/mcp-server && go test ./..."; then
        warn "MCP server tests failed"
        failed=1
    fi

    # Frontend type checking (optional - only if sandbox is available)
    if docker compose ps sandbox 2>/dev/null | grep -q "running"; then
        info "Running frontend type check..."
        if ! docker compose exec sandbox sh -c "cd packages/frontend && pnpm exec svelte-check --threshold warning" 2>/dev/null; then
            warn "Frontend type check failed"
            failed=1
        fi
    else
        info "Skipping frontend type check (sandbox not running)"
    fi

    if [ $failed -eq 0 ]; then
        success "All pre-commit checks passed"
        return 0
    else
        error "Pre-commit checks failed"
    fi
}

cmd_lint() {
    require_docker

    target="${1:-all}"

    case "$target" in
        all)
            info "Running all linters..."
            docker compose exec backend pnpm lint
            ;;
        boundaries)
            info "Checking component boundaries..."
            node scripts/check-boundaries.js
            ;;
        commits)
            info "Checking commit messages..."
            node scripts/check-commits.js
            ;;
        *)
            info "Running lint in $target..."
            docker compose exec "$target" pnpm lint
            ;;
    esac
}

# ===========================================
# Commands: Database
# ===========================================

cmd_db_reset() {
    if [ -f "$DB_FILE" ]; then
        if confirm "This will delete all data. Are you sure?"; then
            info "Backing up current database..."
            cmd_db_backup "pre-reset"

            info "Stopping services..."
            cmd_stop 2>/dev/null || true

            info "Removing database..."
            rm -f "$DB_FILE"
            rm -f "$DB_FILE-wal" "$DB_FILE-shm" 2>/dev/null || true

            success "Database reset complete"
            echo "  Start services to create new database: ./tc start"
        else
            info "Cancelled"
        fi
    else
        info "No database exists yet"
    fi
}

cmd_db_backup() {
    label="${1:-$(date +%Y%m%d-%H%M%S)}"

    if [ ! -f "$DB_FILE" ]; then
        error "No database to backup"
    fi

    mkdir -p "$BACKUP_DIR"
    backup_file="$BACKUP_DIR/travel-$label.db"

    info "Backing up database to $backup_file..."

    # Use SQLite backup command for consistency
    if command -v sqlite3 >/dev/null 2>&1; then
        sqlite3 "$DB_FILE" ".backup '$backup_file'"
    else
        # Fallback to copy (stop services first for consistency)
        cp "$DB_FILE" "$backup_file"
    fi

    success "Backup complete: $backup_file"
}

cmd_db_restore() {
    backup_file="$1"

    if [ -z "$backup_file" ]; then
        # List available backups
        info "Available backups:"
        if [ -d "$BACKUP_DIR" ]; then
            ls -la "$BACKUP_DIR"/*.db 2>/dev/null || echo "  (none)"
        else
            echo "  (none)"
        fi
        echo ""
        echo "Usage: ./tc db:restore <backup-file>"
        return 0
    fi

    if [ ! -f "$backup_file" ]; then
        # Try in backup directory
        if [ -f "$BACKUP_DIR/$backup_file" ]; then
            backup_file="$BACKUP_DIR/$backup_file"
        else
            error "Backup file not found: $backup_file"
        fi
    fi

    if confirm "This will replace the current database. Are you sure?"; then
        info "Stopping services..."
        cmd_stop 2>/dev/null || true

        if [ -f "$DB_FILE" ]; then
            info "Backing up current database..."
            cmd_db_backup "pre-restore"
        fi

        info "Restoring from $backup_file..."
        cp "$backup_file" "$DB_FILE"

        success "Database restored"
        echo "  Start services: ./tc start"
    else
        info "Cancelled"
    fi
}

cmd_db_shell() {
    if [ ! -f "$DB_FILE" ]; then
        error "No database exists. Start services first: ./tc start"
    fi

    if command -v sqlite3 >/dev/null 2>&1; then
        info "Opening SQLite shell..."
        sqlite3 "$DB_FILE"
    else
        # Try using Docker
        require_docker
        info "Opening SQLite shell via Docker..."
        docker compose exec backend sh -c "sqlite3 /app/data/travel.db"
    fi
}

# ===========================================
# Commands: Sandbox (Claude Code Operations)
# ===========================================

cmd_sandbox() {
    require_docker
    action="${1:-help}"
    shift 2>/dev/null || true

    case "$action" in
        start)
            info "Starting sandbox container..."
            docker compose --profile sandbox up -d sandbox
            success "Sandbox ready"
            echo ""
            echo "  Run commands: ./tc exec <command>"
            echo "  Open shell:   ./tc sandbox shell"
            echo "  Stop:         ./tc sandbox stop"
            ;;
        stop)
            info "Stopping sandbox container..."
            docker compose --profile sandbox stop sandbox
            success "Sandbox stopped"
            ;;
        shell)
            if ! docker compose ps sandbox 2>/dev/null | grep -q "running"; then
                info "Starting sandbox container..."
                docker compose --profile sandbox up -d sandbox
            fi
            info "Opening shell in sandbox..."
            docker compose exec sandbox sh
            ;;
        status)
            docker compose ps sandbox
            ;;
        help|*)
            echo "Sandbox Commands:"
            echo ""
            echo "  ./tc sandbox start    Start the sandbox container"
            echo "  ./tc sandbox stop     Stop the sandbox container"
            echo "  ./tc sandbox shell    Open interactive shell"
            echo "  ./tc sandbox status   Show container status"
            echo ""
            echo "  ./tc exec <command>   Run command in sandbox"
            echo ""
            echo "The sandbox provides an isolated environment for Claude Code"
            echo "operations. All commands run inside the container with only"
            echo "the project directory accessible."
            ;;
    esac
}

cmd_exec() {
    require_docker

    if [ $# -eq 0 ]; then
        error "Usage: ./tc exec <command> [args...]"
    fi

    # Start sandbox if not running
    if ! docker compose ps sandbox 2>/dev/null | grep -q "running"; then
        info "Starting sandbox container..."
        docker compose --profile sandbox up -d sandbox
    fi

    # Execute command in sandbox
    docker compose exec sandbox "$@"
}

# ===========================================
# Commands: Go Development
# ===========================================

cmd_go() {
    require_docker

    service="${1:-backend}"
    shift 2>/dev/null || true

    if [ $# -eq 0 ]; then
        echo "Usage: ./tc go [service] <go-command>"
        echo ""
        echo "  service: backend (default), mcp"
        echo ""
        echo "Examples:"
        echo "  ./tc go test ./...              # Run tests in backend"
        echo "  ./tc go mcp test ./...          # Run tests in mcp-server"
        echo "  ./tc go build ./...             # Build backend"
        echo "  ./tc go mod tidy                # Tidy backend dependencies"
        return 0
    fi

    # Check if first arg is a service name
    case "$service" in
        backend|mcp)
            # service is valid, args are the rest
            ;;
        *)
            # First arg is actually a go command, default to backend
            set -- "$service" "$@"
            service="backend"
            ;;
    esac

    # Ensure service is running
    if ! docker compose ps "$service" 2>/dev/null | grep -q "running"; then
        info "Starting $service container..."
        if [ "$service" = "mcp" ]; then
            docker compose --profile mcp up -d "$service"
        else
            docker compose up -d "$service"
        fi
    fi

    info "Running: go $*"
    docker compose exec "$service" go "$@"
}

# ===========================================
# Commands: Health & Diagnostics
# ===========================================

cmd_health() {
    require_docker

    service="${1:-all}"

    check_endpoint() {
        local name=$1
        local url=$2
        local result

        result=$(docker compose exec backend curl -sf "$url" 2>/dev/null)
        if [ $? -eq 0 ]; then
            printf "${GREEN}✓${NC} %s: %s\n" "$name" "$result"
            return 0
        else
            printf "${RED}✗${NC} %s: not responding\n" "$name"
            return 1
        fi
    }

    case "$service" in
        all)
            info "Checking service health..."
            check_endpoint "Backend" "http://localhost:3000/health"
            # Add more services as needed
            ;;
        backend)
            check_endpoint "Backend" "http://localhost:3000/health"
            ;;
        mcp)
            check_endpoint "MCP" "http://localhost:3001/health"
            ;;
        frontend)
            # Frontend doesn't have a health endpoint, check if container is up
            if docker compose ps frontend 2>/dev/null | grep -q "running"; then
                printf "${GREEN}✓${NC} Frontend: container running\n"
            else
                printf "${RED}✗${NC} Frontend: not running\n"
            fi
            ;;
        *)
            echo "Usage: ./tc health [service]"
            echo ""
            echo "  all      - Check all services (default)"
            echo "  backend  - Check backend health"
            echo "  mcp      - Check MCP server health"
            echo "  frontend - Check frontend status"
            ;;
    esac
}

cmd_curl() {
    require_docker

    if [ $# -eq 0 ]; then
        echo "Usage: ./tc curl <url> [curl-options...]"
        echo ""
        echo "Run curl inside the backend container."
        echo ""
        echo "Examples:"
        echo "  ./tc curl http://localhost:3000/health"
        echo "  ./tc curl -X POST http://localhost:3000/api/trips -d '{\"name\":\"test\"}'"
        return 0
    fi

    # Ensure backend is running (has curl installed)
    if ! docker compose ps backend 2>/dev/null | grep -q "running"; then
        info "Starting backend container..."
        docker compose up -d backend
        sleep 3
    fi

    docker compose exec backend curl "$@"
}

# ===========================================
# Commands: Cleanup
# ===========================================

cmd_clean() {
    require_docker

    level="${1:-containers}"

    case "$level" in
        containers)
            if confirm "Remove all containers?"; then
                info "Removing containers..."
                docker compose --profile mcp --profile test down
                success "Containers removed"
            fi
            ;;
        volumes)
            if confirm "Remove containers AND volumes (node_modules)?"; then
                info "Removing containers and volumes..."
                docker compose --profile mcp --profile test down -v
                success "Containers and volumes removed"
            fi
            ;;
        all)
            if confirm "Remove containers, volumes, AND build cache?"; then
                info "Removing everything..."
                docker compose --profile mcp --profile test down -v --rmi local
                docker builder prune -f
                success "Full cleanup complete"
            fi
            ;;
        *)
            echo "Usage: ./tc clean [containers|volumes|all]"
            echo ""
            echo "  containers - Remove containers only (default)"
            echo "  volumes    - Remove containers and volumes"
            echo "  all        - Remove everything including build cache"
            ;;
    esac
}

# ===========================================
# Commands: Help
# ===========================================

cmd_help() {
    cat <<'EOF'
Travel Calendar - Helper Script

Usage: ./tc <command> [options]

Service Commands:
  start [--mcp] [--fg]   Start services (--mcp includes MCP server, --fg foreground)
  stop                   Stop all services
  restart                Restart all services
  build [--clean]        Build containers (--clean for fresh build)
  logs [service]         View logs (optionally for specific service)
  status                 Show container status
  shell [service]        Open shell in container (default: backend)

Testing & Quality:
  test [target]          Run tests (all, e2e, backend, frontend, mcp)
  test-precommit         Fast pre-commit checks (Go tests, type checking)
  lint [target]          Run linting (all, boundaries, commits, or service)

Go Development:
  go [service] <cmd>     Run go command in service (default: backend)
                         Examples: ./tc go test ./...
                                   ./tc go mcp build ./...
                                   ./tc go mod tidy

Health & Diagnostics:
  health [service]       Check service health (all, backend, mcp, frontend)
  curl <url> [opts]      Run curl inside backend container

Database:
  db:reset               Delete database (with backup)
  db:backup [label]      Backup database to data/backups/
  db:restore [file]      Restore database from backup
  db:shell               Open SQLite shell

Cleanup:
  clean [level]          Cleanup (containers, volumes, all)

Sandbox (Claude Code):
  sandbox start          Start sandbox container
  sandbox stop           Stop sandbox container
