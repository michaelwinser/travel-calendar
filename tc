  ./tc db:backup before-refactor  # Create named backup
  ./tc shell backend            # Shell into backend container
  ./tc clean volumes            # Remove containers and node_modules
EOF
}

# ===========================================
# Main
# ===========================================

command="${1:-help}"
shift 2>/dev/null || true

case "$command" in
    start)      cmd_start "$@" ;;
    stop)       cmd_stop "$@" ;;
    restart)    cmd_restart "$@" ;;
    build)      cmd_build "$@" ;;
    logs)       cmd_logs "$@" ;;
    status)     cmd_status "$@" ;;
    shell|sh)   cmd_shell "$@" ;;

    test)       cmd_test "$@" ;;
    test-precommit)  cmd_test_precommit "$@" ;;
    lint)       cmd_lint "$@" ;;

    db:reset)   cmd_db_reset "$@" ;;
    db:backup)  cmd_db_backup "$@" ;;
    db:restore) cmd_db_restore "$@" ;;
    db:shell)   cmd_db_shell "$@" ;;

    clean)      cmd_clean "$@" ;;

    sandbox)    cmd_sandbox "$@" ;;
    exec)       cmd_exec "$@" ;;
    go)         cmd_go "$@" ;;

    health)     cmd_health "$@" ;;
    curl)       cmd_curl "$@" ;;

    help|--help|-h)
        cmd_help
        ;;
    *)
        error "Unknown command: $command. Run './tc help' for usage."
        ;;
esac
