#!/bin/sh
# Travel Calendar - Helper Script
#
# Works on macOS and TrueNAS (FreeBSD)
#
# Usage:
#   ./tc <command> [options]
#
# Commands:
#   start           Start all services
#   stop            Stop all services
#   restart         Restart all services
#   build           Build/rebuild containers
#   logs            View logs (follow mode)
#   status          Show service status
#   shell           Open shell in a container
#   test            Run tests
#   test-precommit  Fast pre-commit checks
#
#   db:reset    Reset database (delete and recreate)
#   db:backup   Backup database to file
#   db:restore  Restore database from backup
#   db:shell    Open SQLite shell
#
#   clean       Remove containers, volumes, and build cache
#   help        Show this help message

set -e

# ===========================================
# Configuration
# ===========================================

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# Colors (disabled if NO_COLOR set or not a terminal)
if [ -z "$NO_COLOR" ] && [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    NC=''
fi

# Database location
DATA_DIR="$SCRIPT_DIR/data"
DB_FILE="$DATA_DIR/travel.db"
BACKUP_DIR="$DATA_DIR/backups"

# ===========================================
# Helpers
# ===========================================

info() {
    printf "${BLUE}▶${NC} %s\n" "$1"
}

success() {
    printf "${GREEN}✓${NC} %s\n" "$1"
}

warn() {
    printf "${YELLOW}⚠${NC} %s\n" "$1"
}

error() {
    printf "${RED}✗${NC} %s\n" "$1" >&2
    exit 1
}

confirm() {
    printf "${YELLOW}?${NC} %s [y/N] " "$1"
    read -r response
    case "$response" in
        [yY][eE][sS]|[yY]) return 0 ;;
        *) return 1 ;;
    esac
}

require_docker() {
    if ! command -v docker >/dev/null 2>&1; then
        error "Docker is not installed. Please install Docker first."
    fi
    if ! docker info >/dev/null 2>&1; then
        error "Docker is not running. Please start Docker first."
    fi
}

# ===========================================
# Commands: Service Management
# ===========================================

cmd_start() {
    require_docker
    info "Starting services..."

    profile=""
    detach="-d"

    while [ $# -gt 0 ]; do
        case "$1" in
            --mcp)     profile="--profile mcp" ;;
            --fg|-f)   detach="" ;;
            *)         break ;;
        esac
        shift
    done

    # shellcheck disable=SC2086
    docker compose $profile up --remove-orphans $detach "$@"

    if [ -n "$detach" ]; then
        success "Services started"
        echo ""
        echo "  Backend:  http://localhost:3000"
        [ -n "$profile" ] && echo "  MCP:      http://localhost:3001"
        echo ""
        echo "  View logs: ./tc logs"
        echo "  Stop:      ./tc stop"
    fi
}

cmd_stop() {
    require_docker
    info "Stopping services..."
    docker compose --profile mcp down "$@"
    success "Services stopped"
}

cmd_restart() {
    require_docker
    info "Restarting services..."
    cmd_stop
    cmd_start "$@"
}

cmd_build() {
    require_docker
    info "Building containers..."

    no_cache=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --clean|--no-cache) no_cache="--no-cache" ;;
            *) break ;;
        esac
        shift
    done

    # Build all services including those in profiles
    # shellcheck disable=SC2086
    docker compose --profile mcp --profile dev build $no_cache "$@"
    success "Build complete"
}

cmd_logs() {
    require_docker
    service="${1:-}"
    if [ -n "$service" ]; then
        docker compose logs -f "$service"
    else
        docker compose logs -f
    fi
}

cmd_status() {
    require_docker
    docker compose ps --all
}

cmd_shell() {
    require_docker
    service="${1:-backend}"
    info "Opening shell in $service..."
    docker compose exec "$service" sh
}

# ===========================================
# Commands: Testing
# ===========================================

cmd_test() {
    require_docker

    target="${1:-all}"

    case "$target" in
        all)
            info "Running all tests..."
            cmd_test_backend
            cmd_test_mcp
            cmd_test_frontend
            success "All tests passed"
            ;;
        e2e)
            info "Running E2E tests..."
            export TRAVEL_API_URL="http://localhost:3000"
            ./tests/e2e/run-all.sh
            ;;
        backend)
            cmd_test_backend
            ;;
        mcp)
            cmd_test_mcp
            ;;
        frontend)
            cmd_test_frontend
            ;;
        *)
            error "Unknown test target: $target. Use: all, e2e, backend, frontend, mcp"
            ;;
    esac
}

cmd_test_backend() {
    require_docker
    info "Running backend tests (Go)..."
    docker compose run --rm --no-deps -T dev sh -c "cd /app/packages/backend && go test ./..."
    success "Backend tests passed"
}

cmd_test_mcp() {
    require_docker
    info "Running MCP server tests (Go)..."
    docker compose run --rm --no-deps -T dev sh -c "cd /app/packages/mcp-server && go test ./..."
    success "MCP tests passed"
}

cmd_test_frontend() {
    require_docker
    info "Running frontend tests..."
    docker compose run --rm --no-deps -T dev sh -c "cd /app/packages/frontend && pnpm test run"
    success "Frontend tests passed"
}

cmd_test_precommit() {
    require_docker
    info "Running pre-commit checks..."

    failed=0

    # Backend Go tests
    info "Running backend tests (Go)..."
    if ! docker compose run --rm --no-deps -T dev sh -c "cd /app/packages/backend && go test ./..."; then
        warn "Backend tests failed"
        failed=1
    fi

    # MCP server Go tests
    info "Running MCP server tests (Go)..."
    if ! docker compose run --rm --no-deps -T dev sh -c "cd /app/packages/mcp-server && go test ./..."; then
        warn "MCP server tests failed"
        failed=1
    fi

    # Frontend type checking (only if svelte-check is installed)
    info "Running frontend type check..."
    if ! docker compose run --rm --no-deps -T dev sh -c "cd /app/packages/frontend && pnpm exec svelte-check --threshold warning 2>/dev/null"; then
        # Check if svelte-check is installed
        if docker compose run --rm --no-deps -T dev sh -c "cd /app/packages/frontend && pnpm exec svelte-check --help >/dev/null 2>&1"; then
            warn "Frontend type check failed"
            failed=1
        else
            info "Skipping frontend type check (svelte-check not installed)"
        fi
    fi

    if [ $failed -eq 0 ]; then
        success "All pre-commit checks passed"
        return 0
    else
        error "Pre-commit checks failed"
    fi
}

# ===========================================
# Commands: Database
# ===========================================

cmd_db_reset() {
    if [ -f "$DB_FILE" ]; then
        if confirm "This will delete all data. Are you sure?"; then
            info "Backing up current database..."
            cmd_db_backup "pre-reset"

            info "Stopping services..."
            cmd_stop 2>/dev/null || true

            info "Removing database..."
            rm -f "$DB_FILE"
            rm -f "$DB_FILE-wal" "$DB_FILE-shm" 2>/dev/null || true

            success "Database reset complete"
            echo "  Start services to create new database: ./tc start"
        else
            info "Cancelled"
        fi
    else
        info "No database exists yet"
    fi
}

cmd_db_backup() {
    label="${1:-$(date +%Y%m%d-%H%M%S)}"

    if [ ! -f "$DB_FILE" ]; then
        error "No database to backup"
    fi

    mkdir -p "$BACKUP_DIR"
    backup_file="$BACKUP_DIR/travel-$label.db"

    info "Backing up database to $backup_file..."

    # Use SQLite backup command for consistency
    if command -v sqlite3 >/dev/null 2>&1; then
        sqlite3 "$DB_FILE" ".backup '$backup_file'"
    else
        # Fallback to copy (stop services first for consistency)
        cp "$DB_FILE" "$backup_file"
    fi

    success "Backup complete: $backup_file"
}

cmd_db_restore() {
    backup_file="$1"

    if [ -z "$backup_file" ]; then
        # List available backups
        info "Available backups:"
        if [ -d "$BACKUP_DIR" ]; then
            ls -la "$BACKUP_DIR"/*.db 2>/dev/null || echo "  (none)"
        else
            echo "  (none)"
        fi
        echo ""
        echo "Usage: ./tc db:restore <backup-file>"
        return 0
    fi

    if [ ! -f "$backup_file" ]; then
        # Try in backup directory
        if [ -f "$BACKUP_DIR/$backup_file" ]; then
            backup_file="$BACKUP_DIR/$backup_file"
        else
            error "Backup file not found: $backup_file"
        fi
    fi

    if confirm "This will replace the current database. Are you sure?"; then
        info "Stopping services..."
        cmd_stop 2>/dev/null || true

        if [ -f "$DB_FILE" ]; then
            info "Backing up current database..."
            cmd_db_backup "pre-restore"
        fi

        info "Restoring from $backup_file..."
        cp "$backup_file" "$DB_FILE"

        success "Database restored"
        echo "  Start services: ./tc start"
    else
        info "Cancelled"
    fi
}

cmd_db_shell() {
    if [ ! -f "$DB_FILE" ]; then
        error "No database exists. Start services first: ./tc start"
    fi

    if command -v sqlite3 >/dev/null 2>&1; then
        info "Opening SQLite shell..."
        sqlite3 "$DB_FILE"
    else
        # Try using Docker
        require_docker
        info "Opening SQLite shell via Docker..."
        docker compose exec backend sh -c "sqlite3 /app/data/travel.db"
    fi
}

# ===========================================
# Commands: Health & Diagnostics
# ===========================================

cmd_health() {
    require_docker

    service="${1:-all}"

    check_endpoint() {
        local name=$1
        local url=$2
        local result

        result=$(docker compose exec backend curl -sf "$url" 2>/dev/null)
        if [ $? -eq 0 ]; then
            printf "${GREEN}✓${NC} %s: %s\n" "$name" "$result"
            return 0
        else
            printf "${RED}✗${NC} %s: not responding\n" "$name"
            return 1
        fi
    }

    case "$service" in
        all)
            info "Checking service health..."
            check_endpoint "Backend" "http://localhost:3000/health"
            ;;
        backend)
            check_endpoint "Backend" "http://localhost:3000/health"
            ;;
        mcp)
            # Use container hostname since we're checking from inside backend container
            check_endpoint "MCP" "http://mcp:3001/health"
            ;;
        *)
            echo "Usage: ./tc health [service]"
            echo ""
            echo "  all      - Check all services (default)"
            echo "  backend  - Check backend health"
            echo "  mcp      - Check MCP server health"
            ;;
    esac
}

cmd_curl() {
    require_docker

    if [ $# -eq 0 ]; then
        echo "Usage: ./tc curl <url> [curl-options...]"
        echo ""
        echo "Run curl inside the backend container."
        echo ""
        echo "Examples:"
        echo "  ./tc curl http://localhost:3000/health"
        echo "  ./tc curl -X POST http://localhost:3000/api/trips -d '{\"name\":\"test\"}'"
        return 0
    fi

    # Ensure backend is running (has curl installed)
    if ! docker compose ps backend 2>/dev/null | grep -q "running"; then
        info "Starting backend container..."
        docker compose up -d backend
        sleep 3
    fi

    docker compose exec backend curl "$@"
}

# ===========================================
# Commands: Cleanup
# ===========================================

cmd_clean() {
    require_docker

    level="${1:-containers}"

    case "$level" in
        containers)
            if confirm "Remove all containers?"; then
                info "Removing containers..."
                docker compose --profile mcp --profile dev down
                success "Containers removed"
            fi
            ;;
        volumes)
            if confirm "Remove containers AND volumes (Go cache)?"; then
                info "Removing containers and volumes..."
                docker compose --profile mcp --profile dev down -v
                success "Containers and volumes removed"
            fi
            ;;
        all)
            if confirm "Remove containers, volumes, AND build cache?"; then
                info "Removing everything..."
                docker compose --profile mcp --profile dev down -v --rmi local
                docker builder prune -f
                success "Full cleanup complete"
            fi
            ;;
        *)
            echo "Usage: ./tc clean [containers|volumes|all]"
            echo ""
            echo "  containers - Remove containers only (default)"
            echo "  volumes    - Remove containers and volumes"
            echo "  all        - Remove everything including build cache"
            ;;
    esac
}

# ===========================================
# Commands: Help
# ===========================================

cmd_help() {
    cat <<'EOF'
Travel Calendar - Helper Script

Usage: ./tc <command> [options]

Service Commands:
  start [--mcp] [--fg]   Start services (--mcp includes MCP server, --fg foreground)
  stop                   Stop all services
  restart                Restart all services
  build [--clean]        Build containers (--clean for fresh build)
  logs [service]         View logs (optionally for specific service)
  status                 Show container status
  shell [service]        Open shell in container (default: backend)

Testing & Quality:
  test [target]          Run tests (all, e2e, backend, frontend, mcp)
  test-precommit         Pre-commit checks (Go tests, type checking)

Health & Diagnostics:
  health [service]       Check service health (all, backend, mcp)
  curl <url> [opts]      Run curl inside backend container

Database:
  db:reset               Delete database (with backup)
  db:backup [label]      Backup database to data/backups/
  db:restore [file]      Restore database from backup
  db:shell               Open SQLite shell

Cleanup:
  clean [level]          Cleanup (containers, volumes, all)

Other:
  help                   Show this help message

Examples:
  ./tc start                    # Start backend
  ./tc start --mcp              # Start with MCP server
  ./tc logs backend             # Follow backend logs
  ./tc health                   # Check all service health
  ./tc curl http://localhost:3000/api/trips  # Call API endpoint
  ./tc test backend             # Run backend tests
  ./tc test-precommit           # Run pre-commit checks
  ./tc db:backup before-refactor  # Create named backup
  ./tc shell backend            # Shell into backend container
  ./tc clean volumes            # Remove containers and Go cache
EOF
}

# ===========================================
# Main
# ===========================================

command="${1:-help}"
shift 2>/dev/null || true

case "$command" in
    start)      cmd_start "$@" ;;
    stop)       cmd_stop "$@" ;;
    restart)    cmd_restart "$@" ;;
    build)      cmd_build "$@" ;;
    logs)       cmd_logs "$@" ;;
    status)     cmd_status "$@" ;;
    shell|sh)   cmd_shell "$@" ;;

    test)       cmd_test "$@" ;;
    test-precommit)  cmd_test_precommit "$@" ;;

    db:reset)   cmd_db_reset "$@" ;;
    db:backup)  cmd_db_backup "$@" ;;
    db:restore) cmd_db_restore "$@" ;;
    db:shell)   cmd_db_shell "$@" ;;

    clean)      cmd_clean "$@" ;;

    health)     cmd_health "$@" ;;
    curl)       cmd_curl "$@" ;;

    help|--help|-h)
        cmd_help
        ;;
    *)
        error "Unknown command: $command. Run './tc help' for usage."
        ;;
esac
