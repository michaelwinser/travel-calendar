{
  "name": "travel-calendar-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error --compiler-warnings state_referenced_locally:ignore,non_reactive_update:ignore,a11y_no_static_element_interactions:ignore,a11y_no_noninteractive_element_interactions:ignore,a11y_click_events_have_key_events:ignore,css_unused_selector:ignore",
    "preview": "vite preview",
    "typegen": "openapi-typescript ../openapi.yaml -o src/lib/api-types.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.4.5",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
