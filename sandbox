#!/bin/sh
# Run a command inside a nono sandbox with project-specific capabilities.
#
# Usage:
#   ./sandbox claude                    # Interactive Claude Code session
#   ./sandbox ./dev ci                  # CI pipeline
#   ./sandbox ./travel list             # CLI command
#   TRAVEL_TEST_MODE=true ./sandbox ... # With test auth
#
# The sandbox provides:
#   - Read+write: project directory, app data, Go module cache
#   - Read-only:  Go toolchain, homebrew, appbase sibling (see #142), system paths
#   - Network:    allowed (for go modules, docker, etc.)
#   - Port 3001:  bound (for dev server)

set -e

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Check nono is available
if ! command -v nono >/dev/null 2>&1; then
    echo "nono not found — running unsandboxed"
    exec "$@"
fi

# Ensure Go and homebrew are on PATH (nono doesn't source shell profiles)
for p in /opt/homebrew/bin /usr/local/bin /usr/local/go/bin "$HOME/go/bin"; do
    case ":$PATH:" in
        *":$p:"*) ;;
        *) [ -d "$p" ] && export PATH="$p:$PATH" ;;
    esac
done

# Resolve Go binary location for sandbox allowlist
GO_BIN_DIR=""
if command -v go >/dev/null 2>&1; then
    GO_BIN_DIR="$(dirname "$(command -v go)")"
fi

# Pre-resolve GOROOT so Go works inside the sandbox
if command -v go >/dev/null 2>&1 && [ -z "$GOROOT" ]; then
    export GOROOT="$(go env GOROOT)"
fi

# Determine if interactive (Claude Code, shell)
EXEC_FLAG=""
case "$1" in
    claude|bash|zsh|sh|vim|nvim)
        EXEC_FLAG="--exec"
        ;;
esac

# Resolve appbase sibling directory (needed until #142 removes this dependency)
APPBASE_DIR=""
if [ -d "$PROJECT_DIR/../appbase" ]; then
    APPBASE_DIR="$(cd "$PROJECT_DIR/../appbase" && pwd)"
fi

APPBASE_FLAG=""
if [ -n "$APPBASE_DIR" ]; then
    APPBASE_FLAG="--read $APPBASE_DIR"
fi

GO_FLAG=""
if [ -n "$GO_BIN_DIR" ] && [ "$GO_BIN_DIR" != "/usr/bin" ]; then
    GO_FLAG="--read $GO_BIN_DIR"
fi

# Suppress Docker config warning (nono blocks ~/.docker as a sensitive path — correct behavior)
# Create a local empty config and point Docker at it
DOCKER_DIR="$PROJECT_DIR/.docker"
mkdir -p "$DOCKER_DIR" 2>/dev/null
[ -f "$DOCKER_DIR/config.json" ] || echo '{}' > "$DOCKER_DIR/config.json"
export DOCKER_CONFIG="$DOCKER_DIR"

exec nono run \
    --profile claude-code \
    --allow "$PROJECT_DIR" \
    --allow "$HOME/.config/travel" \
    --allow "$HOME/go" \
    --read "$HOME/sdk" \
    --allow-bind 3001 \
    $APPBASE_FLAG \
    $GO_FLAG \
    $EXEC_FLAG \
    -- "$@"
