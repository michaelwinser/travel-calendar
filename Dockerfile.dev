# Development Dockerfile for Travel Calendar
#
# This image is used for local development with hot reload.
# All services share this base image.
#
# Usage:
#   docker compose up              # Start all services
#   docker compose up backend      # Start specific service
#   docker compose exec backend sh # Shell into container

FROM node:20-alpine

# Install pnpm via corepack (built into Node 20+)
RUN corepack enable && corepack prepare pnpm@latest --activate

# Install useful dev tools
RUN apk add --no-cache \
    git \
    curl \
    bash \
    jq \
    sqlite

# Set working directory
WORKDIR /app

# Copy workspace configuration
COPY package.json pnpm-workspace.yaml ./

# Create package directories and copy package.json files
# Must preserve directory structure for pnpm workspace
RUN mkdir -p packages/backend packages/frontend packages/mcp-server packages/shared

COPY packages/backend/package.json ./packages/backend/
COPY packages/frontend/package.json ./packages/frontend/
COPY packages/mcp-server/package.json ./packages/mcp-server/
COPY packages/shared/package.json ./packages/shared/

# Install dependencies
# pnpm will create node_modules at workspace root and symlinks in packages
RUN pnpm install

# Source code will be mounted as volumes for hot reload
# See docker-compose.yml for volume configuration

# Default command (overridden per-service in docker-compose.yml)
CMD ["pnpm", "dev"]
