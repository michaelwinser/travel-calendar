#!/bin/sh
# travel-calendar project commands
# Sources shared template from appbase — bug fixes propagate automatically.
set -e
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# Source shared dev functions
. "../appbase/deploy/dev-template.sh"

# App-specific settings
APP_BINARY_NAME="travel"
APP_E2E_DIR="tests/e2e"

# --- Frontend build (runs in devcontainer) ---

_build_frontend() {
    echo "Building frontend..."
    _dc_file=".devcontainer/docker-compose.yml"

    docker compose -f "$_dc_file" run --rm -T frontend sh -c "
        cd /app/frontend
        if [ ! -d node_modules ]; then pnpm install; fi
        pnpm build
    "
}

# Override dev_build to include frontend
dev_build() {
    target="${1:-all}"
    case "$target" in
        all)
            _build_frontend
            echo "Building server..."
            go build -o "$APP_BINARY_NAME" .
            ;;
        server)
            go build -o "$APP_BINARY_NAME" .
            ;;
        frontend)
            _build_frontend
            ;;
        desktop)
            _build_frontend
            echo "Building desktop..."
            mkdir -p cmd/desktop/dist cmd/desktop/frontend
            cp -r frontend/dist/* cmd/desktop/dist/ 2>/dev/null || true
            export PATH="$PATH:$(go env GOPATH)/bin"
            (cd cmd/desktop && wails build -tags desktop -skipbindings)
            ;;
        *)
            echo "Usage: ./dev build [all|server|frontend|desktop]"
            return 1
            ;;
    esac
}

_check_frontend() {
    echo "Type-checking frontend..."
    _dc_file=".devcontainer/docker-compose.yml"

    docker compose -f "$_dc_file" run --rm -T frontend sh -c "
        cd /app/frontend
        if [ ! -d node_modules ]; then pnpm install; fi
        pnpm check
    "
}

# Override dev_ci to include frontend type checking
dev_ci() {
    appbase lint-api 2>/dev/null || true
    go vet ./...
    if command -v staticcheck >/dev/null 2>&1; then
        staticcheck ./internal/... ./gazetteer/... .
    fi
    go build -o "$APP_BINARY_NAME" .
    _check_frontend
    _build_frontend
    go test -v -count=1 ./...
    dev_e2e
}

dev_deploy() {
    # Sandbox gate: deploy needs cloud credentials that the sandbox correctly blocks
    if [ -n "$NONO_CAP_FILE" ]; then
        echo "Error: deploy cannot run inside a nono sandbox."
        echo "The sandbox blocks cloud credentials (~/.config/gcloud) by design."
        echo "Run ./dev deploy directly, outside the sandbox."
        return 1
    fi

    # Deploy gate: CI must pass before deploying
    echo "Running CI checks before deploy..."
    dev_ci || { echo "CI failed. Fix errors before deploying."; return 1; }

    if [ -n "$(git status --porcelain)" ]; then
        echo "Working tree is dirty. Commit changes before deploying."
        return 1
    fi

    echo "CI passed. Deploying..."
    _load_secrets && appbase deploy
}

# Dispatch — add app-specific commands before the fallthrough
case "${1:-help}" in
    check)   _check_frontend ;;
    deploy)  dev_deploy ;;
    release) shift; scripts/release.sh "$@" ;;
    *)  dev_dispatch "$@" ;;
esac
