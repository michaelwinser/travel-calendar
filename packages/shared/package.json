{
  "name": "@travel-calendar/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./api": {
      "import": "./src/api.ts",
      "types": "./src/api.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "generate": "openapi-typescript ../api/openapi.yaml -o ./src/api.ts",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "eslint": "^8.0.0",
    "openapi-typescript": "^7.0.0"
  }
}
